# ─────────────────────────────────────────────────────────────────
# DespensaDigital — Mobile — Variables de entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a .env
#   2. Ejecuta: ipconfig (Windows) o ifconfig (Mac/Linux)
#   3. Copia tu "Dirección IPv4" y reemplaza TU_IP_AQUI
#
# IMPORTANTE: Nunca uses "localhost" aquí — el celular no puede
#             resolver localhost de tu PC. Usa la IP real.
# ─────────────────────────────────────────────────────────────────

API_BASE_URL=http://TU_IP_AQUI:3001
WEB_CALLBACK_URL=http://TU_IP_AQUI:5173
