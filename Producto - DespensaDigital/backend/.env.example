# ─────────────────────────────────────────────────────────────────
# DespensaDigital — Backend — Variables de entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a .env
#   2. Rellena cada valor con tus propias credenciales
#   3. Nunca subas el archivo .env a GitHub
# ─────────────────────────────────────────────────────────────────

PORT=3002

NODE_ENV=development

# Supabase PostgreSQL (Pooler Transaction Mode, puerto 6543)
# Obtén la URL en: Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:6543/postgres

# JWT — genera un secreto aleatorio de mínimo 32 caracteres
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TU_JWT_SECRET_AQUI

# CORS — URLs permitidas (separadas por coma)
# En desarrollo local:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Con celular en la misma red (agrega tu IP):
# CORS_ORIGIN=http://localhost:5173,http://TU_IP:5173,http://localhost:8081,http://TU_IP:8081
